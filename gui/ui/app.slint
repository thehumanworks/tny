import { ScrollView, AboutSlint } from "std-widgets.slint";

export struct ChatRow { role: string, body: string, meta: string }
export struct SessionRow { id: string, title: string, meta: string }
export struct SwarmRow { title: string, detail: string }
export struct SuggestionRow { label: string, detail: string }
export struct BoardMessage { heading: string, id: string, state: string, body: string }
export struct ProviderRow { name: string, detail: string, ready: bool }
export struct ModelRow { id: string, label: string, detail: string }

// One page tone everywhere. Hierarchy comes from type weight and lighter tones
// of the same green-grey scale; elevation, where needed, comes from shadow.
// Interaction never changes a color: clickable things get a pointer cursor.
global Theme {
    out property <color> page: #f7f8f6;
    out property <color> surface: #ffffff;
    out property <color> ink: #1f2d25;
    out property <color> text: #2f3d34;
    out property <color> muted: #66766c;
    out property <color> faint: #97a39b;
    out property <color> ghost: #c2cac4;
    out property <color> accent: #34523f;
    out property <color> accent-muted: #a7b6aa;
    out property <color> alert: #a4483a;
    out property <color> alert-muted: #b27b6f;
    out property <color> shadow: #1c2b2226;
    out property <color> shadow-soft: #1c2b2214;
}

// Tooltip card: short tips fit their text, long ones wrap at a readable width.
component Tip inherits Rectangle {
    in property <string> text;
    width: min(label.preferred-width, 268px) + 22px;
    height: label.height + 16px;
    background: Theme.surface;
    border-radius: 8px;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;
    label := Text {
        x: 11px;
        y: 8px;
        width: root.width - 22px;
        height: self.preferred-height;
        text: root.text;
        color: Theme.text;
        font-size: 11px;
        wrap: word-wrap;
    }
}

component Caption inherits Text {
    color: Theme.faint;
    font-size: 11px;
    font-weight: 600;
}

component Hint inherits Text {
    color: Theme.faint;
    font-size: 11px;
    wrap: word-wrap;
}

// Quiet text-only action. Disabled actions fade in tone; nothing reacts on hover.
component TextAction inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <color> tone: Theme.muted;
    in property <length> font-size: 12px;
    in property <int> weight: 500;
    in property <length> pad: 8px;
    callback clicked;
    horizontal-stretch: 0;
    min-height: 28px;
    HorizontalLayout {
        padding-left: root.pad; padding-right: root.pad;
        Text {
            text: root.text;
            color: root.enabled ? root.tone : Theme.ghost;
            font-size: root.font-size;
            font-weight: root.weight;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
    }
    if root.tip != "": Tooltip { Tip { text: root.tip; } }
}

// Elevated secondary button (shadow, no outline), or the dark primary button.
component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked;
    horizontal-stretch: 0;
    height: 30px;
    border-radius: 15px;
    background: root.primary ? (root.enabled ? Theme.accent : Theme.accent-muted) : Theme.surface;
    drop-shadow-blur: root.primary ? 0px : 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow-soft;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px;
        Text {
            text: root.text;
            color: root.primary ? #ffffff : (root.enabled ? Theme.text : Theme.ghost);
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
    }
    if root.tip != "": Tooltip { Tip { text: root.tip; } }
}

// A text field lifted off the page by a soft shadow instead of an outline.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> multiline: false;
    in property <string> tip;
    callback edited(string);
    callback accepted(string);
    public function focus-input() { input.focus(); }
    height: root.multiline ? 64px : 34px;
    border-radius: 9px;
    background: Theme.surface;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: Theme.shadow-soft;
    clip: true;
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    if root.text == "": Text {
        x: 11px;
        y: root.multiline ? 9px : (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.faint;
        font-size: 12px;
    }
    input := TextInput {
        x: 11px;
        y: root.multiline ? 9px : (parent.height - self.height) / 2;
        width: parent.width - 22px;
        height: root.multiline ? parent.height - 18px : self.preferred-height;
        text <=> root.text;
        single-line: !root.multiline;
        wrap: root.multiline ? word-wrap : no-wrap;
        font-size: 12px;
        color: Theme.text;
        selection-background-color: #cfdcd1;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
    if root.tip != "": Tooltip { Tip { text: root.tip; } }
}

// Radio-style choice row: a filled dot marks the current state.
component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    in property <string> tip;
    callback clicked;
    min-height: 40px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            Rectangle {
                width: 14px; height: 14px; border-radius: 7px;
                border-width: root.selected ? 0px : 1.5px;
                border-color: Theme.ghost;
                background: root.selected ? Theme.accent : transparent;
                Rectangle {
                    visible: root.selected;
                    width: 5px; height: 5px; border-radius: 2.5px;
                    background: #ffffff;
                }
            }
        }
        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                color: root.selected ? Theme.ink : Theme.text;
                font-size: 12px;
                font-weight: root.selected ? 600 : 400;
            }
            Text { text: root.detail; color: Theme.faint; font-size: 11px; wrap: word-wrap; }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.tip != "": Tooltip { Tip { text: root.tip; } }
}

// Centers content in a readable column that grows to `measure`, then lets the
// side margins take the remaining width.
component Measure inherits HorizontalLayout {
    in property <length> measure: 760px;
    in property <length> gap: 0px;
    vertical-stretch: 0;
    padding-left: 32px;
    padding-right: 32px;
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        horizontal-stretch: 1000;
        max-width: root.measure;
        alignment: start;
        spacing: root.gap;
        @children
    }
    Rectangle { horizontal-stretch: 1; }
}

component WindowDot inherits Rectangle {
    in property <color> tone;
    in property <string> tip;
    callback clicked;
    width: 13px; height: 13px; border-radius: 6.5px;
    background: root.tone;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { Tip { text: root.tip; } }
}

export component App inherits Window {
    title: "tny · desktop";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 820px;
    min-height: 560px;
    no-frame: true;
    resize-border-width: 7px;
    background: Theme.page;
    default-font-size: 13px;

    in property <[ChatRow]> chat;
    in property <[SessionRow]> sessions;
    in property <[SwarmRow]> swarms;
    in property <[SuggestionRow]> suggestions;
    in property <[BoardMessage]> board-messages;
    in property <[ProviderRow]> providers;
    in property <[ModelRow]> models;
    in property <string> picker-provider: "";
    in property <string> picker-model: "";
    in property <string> model-label: "Default model";
    in property <string> models-status: "";
    in property <string> current-session-id: "";
    in property <bool> board-has-run: false;
    in property <bool> board-open-busy: false;
    in property <string> board-status: "Parent inbox not opened";
    in property <string> completion-note: "";
    in property <string> session-title: "New conversation";
    in property <string> workspace-label: "Workspace";
    in property <string> connection-label: "This computer";
    in property <string> status-label: "Ready";
    in property <string> usage-label: "Tokens —";
    in property <string> allowance-label: "";
    in property <string> mailbox-label: "Mailbox · select a run";
    in property <bool> busy: false;
    in property <bool> swarm-enabled: false;
    in property <int> swarm-count: 2;
    in property <string> swarm-mode-label: "Solo";
    in property <bool> has-session: false;
    in property <bool> saved-read-only: false;
    in property <string> saved-read-only-note: "";
    in property <bool> needs-tool-confirmation: false;
    in property <bool> ssh-configured: false;
    in property <bool> error-visible: false;
    in property <string> error-text: "";
    in-out property <string> draft: "";
    in-out property <string> ssh-target: "";
    in-out property <string> image-path: "";
    in-out property <string> swarm-run: "";
    in-out property <string> image-gen-prompt: "";
    in-out property <string> image-gen-output: "";
    in property <string> generated-path: "";
    in property <bool> image-gen-busy: false;
    in property <string> image-gen-result: "";
    in-out property <bool> about-open: false;
    in-out property <bool> tools-open: true;
    callback submit(string);
    callback new-session();
    callback select-session(int);
    callback confirm-tool-location(bool);
    callback refresh();
    callback check-allowance();
    callback draft-edited(string);
    callback choose-suggestion(int);
    callback generate-image(string, string);
    callback attach-generated();
    callback optimise(string);
    callback dictate();
    callback apply-ssh(string);
    callback disconnect-ssh();
    callback change-swarm(int);
    callback inspect-swarm(string);
    callback run-edited(string);
    callback open-parent-inbox();
    callback clear-error();
    callback open-model-picker();
    callback pick-provider(string);
    callback pick-model(string);
    callback jump-to-latest();
    jump-to-latest => {
        history.content-y = min(0px, history.visible-height - history.content-height);
    }

    // Narrow windows keep the conversation readable: an open tools panel wins over
    // the sidebar. A change handler, not a binding: the window width depends on layout.
    property <bool> narrow: false;
    changed width => { root.narrow = self.width < 1100px; }
    property <bool> show-sidebar: !root.narrow || !root.tools-open;
    property <bool> can-send: !root.busy && !root.saved-read-only && !root.needs-tool-confirmation && root.draft != "";
    function send() {
        if root.can-send {
            root.submit(root.draft);
        }
    }

    VerticalLayout {
        spacing: 0px;

        // Title bar: drag anywhere on it. Same tone as the page, no rule below.
        Rectangle {
            height: 52px;
            WindowMoveArea { width: parent.width; height: parent.height; }
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 22px; padding-right: 18px; spacing: 6px;
                HorizontalLayout {
                    width: 232px;
                    Text { text: "tny"; color: Theme.ink; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                }
                Text {
                    text: root.session-title;
                    color: Theme.ink;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                }
                Rectangle { horizontal-stretch: 1; }
                TextAction {
                    text: root.connection-label + "  ▾";
                    tone: Theme.muted;
                    tip: "Where the agent's tools (shell commands, file edits) run. Click to show the tools panel and change it.";
                    clicked => { root.tools-open = true; }
                }
                TextAction {
                    text: "↻";
                    font-size: 17px;
                    tone: Theme.muted;
                    tip: "Refresh sessions, token usage, background agents and file suggestions.";
                    clicked => { root.refresh(); }
                }
                TextAction {
                    text: root.tools-open ? "Hide tools" : "Tools";
                    tone: Theme.muted;
                    tip: root.tools-open ? "Hide the tools panel." : "Show the tools panel: where tools run, image attachments and generation, swarm runs and the parent inbox.";
                    clicked => { root.tools-open = !root.tools-open; }
                }
                TextAction {
                    text: "About";
                    tone: Theme.faint;
                    tip: "About tny and the Slint toolkit.";
                    clicked => { root.about-open = true; }
                }
                HorizontalLayout {
                    padding-left: 12px; spacing: 9px;
                    horizontal-stretch: 0;
                    VerticalLayout { alignment: center; WindowDot { tone: #c9d1ca; tip: "Minimize"; clicked => { root.minimized = true; } } }
                    VerticalLayout { alignment: center; WindowDot { tone: #aebdb0; tip: root.maximized ? "Restore" : "Maximize"; clicked => { root.maximized = !root.maximized; } } }
                    VerticalLayout { alignment: center; WindowDot { tone: #d3a79e; tip: "Close"; clicked => { root.close(); } } }
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;

            // ── Sidebar ─────────────────────────────────────────────────────
            if root.show-sidebar: VerticalLayout {
                width: 256px;
                padding-left: 14px; padding-right: 10px; padding-top: 4px; padding-bottom: 16px;
                spacing: 0px;
                TextAction {
                    text: "+   New chat";
                    tone: Theme.ink;
                    font-size: 13px;
                    weight: 600;
                    min-height: 34px;
                    tip: "Start a new conversation. Same as typing /new.";
                    clicked => { root.new-session(); }
                }
                HorizontalLayout {
                    padding-left: 8px; padding-top: 18px; padding-bottom: 6px;
                    Caption { text: "Recent"; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for row[i] in root.sessions: Rectangle {
                            height: 50px;
                            property <bool> current: row.id == root.current-session-id;
                            VerticalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 1px;
                                alignment: center;
                                Text {
                                    text: row.title;
                                    color: current ? Theme.ink : Theme.text;
                                    font-weight: current ? 600 : 400;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                Text { text: row.meta; color: Theme.faint; font-size: 11px; overflow: elide; }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.select-session(i); } }
                        }
                        if root.sessions.length == 0: Hint {
                            text: "No saved sessions yet";
                            height: 40px;
                        }
                    }
                }
                VerticalLayout {
                    padding-left: 8px; padding-top: 18px; spacing: 6px;
                    Caption {
                        text: "Background agents";
                        Tooltip { Tip { text: "Agents still running in the background for this workspace, or the members of the swarm run you are inspecting."; } }
                    }
                    for row in root.swarms: VerticalLayout {
                        spacing: 1px;
                        Text { text: row.title; color: Theme.text; font-size: 12px; overflow: elide; }
                        Text { text: row.detail; color: Theme.faint; font-size: 11px; overflow: elide; }
                    }
                    if root.swarms.length == 0: Hint { text: "None running"; }
                    Text {
                        text: root.mailbox-label;
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                        Tooltip { Tip { text: "Passive mailbox capacity for the inspected run: history used and the recipient's pending backlog. Reading this never opens or consumes messages."; } }
                    }
                    Text {
                        text: root.workspace-label;
                        color: Theme.faint;
                        font-size: 11px;
                        overflow: elide;
                        Tooltip { Tip { text: "Workspace: " + root.workspace-label; } }
                    }
                }
            }

            // ── Conversation ────────────────────────────────────────────────
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                if root.error-visible: Measure {
                    padding-top: 6px; padding-bottom: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.error-text; color: Theme.alert; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        TextAction { text: "Dismiss"; tone: Theme.alert-muted; font-size: 11px; clicked => { root.clear-error(); } }
                    }
                }
                if root.saved-read-only: Measure {
                    padding-top: 6px; padding-bottom: 6px;
                    Text { text: root.saved-read-only-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                }
                if root.needs-tool-confirmation && !root.saved-read-only: Measure {
                    padding-top: 8px; padding-bottom: 10px; gap: 6px;
                    Text { text: "Where should tools run when you continue this chat?"; color: Theme.ink; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                    Hint { text: "Saved chats don't record which machine their tools used. Pick one before sending; nothing runs until you do."; }
                    HorizontalLayout {
                        spacing: 10px; padding-top: 4px;
                        PillButton {
                            text: "Run tools on this computer";
                            tip: "Continue with shell commands and file edits running locally, in " + root.workspace-label + ".";
                            clicked => { root.confirm-tool-location(false); }
                        }
                        if root.ssh-configured: PillButton {
                            text: "Run tools on " + root.connection-label;
                            tip: "Continue with tools running on the SSH host currently configured in the tools panel.";
                            clicked => { root.confirm-tool-location(true); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                history := ScrollView {
                    vertical-stretch: 1;
                    Measure {
                        padding-top: 18px; padding-bottom: 24px;
                        gap: 26px;
                        if root.chat.length == 0: VerticalLayout {
                            padding-top: 120px; spacing: 10px;
                            Text { text: "A quieter place to build."; color: Theme.ink; font-size: 26px; font-weight: 600; horizontal-alignment: center; }
                            Text { text: "Ask a question, open a recent chat, or bring in a swarm."; color: Theme.faint; font-size: 13px; horizontal-alignment: center; }
                        }
                        for row in root.chat: VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: row.role;
                                font-size: 11px;
                                font-weight: 700;
                                color: row.role == "You" ? Theme.muted : Theme.faint;
                            }
                            Text { text: row.body; font-size: 14px; color: row.role == "You" ? Theme.ink : Theme.text; wrap: word-wrap; }
                            if row.meta != "": Text { text: row.meta; font-size: 11px; color: Theme.faint; }
                        }
                    }
                }

                // Composer: the one elevated surface on the page.
                HorizontalLayout {
                    vertical-stretch: 0;
                    padding-left: 24px; padding-right: 24px; padding-top: 6px; padding-bottom: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    card := Rectangle {
                        horizontal-stretch: 1000;
                        max-width: 792px;
                        background: Theme.surface;
                        border-radius: 18px;
                        drop-shadow-blur: 24px;
                        drop-shadow-offset-y: 6px;
                        drop-shadow-color: Theme.shadow;
                        VerticalLayout {
                            padding-left: 16px; padding-right: 10px; padding-top: 12px; padding-bottom: 10px;
                            spacing: 8px;

                            if root.suggestions.length > 0: VerticalLayout {
                                spacing: 0px;
                                for item[i] in root.suggestions: Rectangle {
                                    height: 28px;
                                    HorizontalLayout {
                                        padding-right: 8px; spacing: 8px;
                                        Text { text: item.label; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                        Text { text: item.detail; color: Theme.faint; font-size: 11px; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.choose-suggestion(i); } }
                                }
                            }
                            if root.completion-note != "": Text { text: root.completion-note; color: Theme.faint; font-size: 11px; wrap: word-wrap; }
                            if root.image-path != "": HorizontalLayout {
                                spacing: 4px;
                                Text { text: "Image attached · " + root.image-path; color: Theme.muted; font-size: 11px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                TextAction { text: "Remove"; tone: Theme.faint; font-size: 11px; tip: "Don't send this image with the next message."; clicked => { root.image-path = ""; } }
                            }

                            // Enter sends; Shift+Enter inserts a new line.
                            keys := FocusScope {
                                focus-on-click: false;
                                focus-on-tab-navigation: false;
                                height: clamp(composer.preferred-height, 22px, 190px);
                                capture-key-pressed(event) => {
                                    if event.text == Key.Return && !event.modifiers.shift {
                                        root.send();
                                        return accept;
                                    }
                                    return reject;
                                }
                                TouchArea { mouse-cursor: MouseCursor.text; clicked => { composer.focus(); } }
                                if root.draft == "": Text {
                                    x: 0px; y: 0px;
                                    text: root.busy ? "tny is working…" : "Message tny  —  @ for files, $ for skills, / for commands";
                                    color: Theme.faint;
                                    font-size: 14px;
                                }
                                flick := Flickable {
                                    content-height: max(self.height, composer.preferred-height);
                                    composer := TextInput {
                                        width: flick.width;
                                        height: max(flick.height, self.preferred-height);
                                        text <=> root.draft;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-size: 14px;
                                        color: Theme.ink;
                                        selection-background-color: #cfdcd1;
                                        edited => { root.draft-edited(self.text); }
                                        cursor-position-changed(pos) => {
                                            if pos.y + flick.content-y + 20px > flick.height {
                                                flick.content-y = flick.height - pos.y - 20px;
                                            } else if pos.y + flick.content-y < 0px {
                                                flick.content-y = -pos.y;
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 32px; spacing: 2px;
                                TextAction {
                                    text: "Optimise";
                                    pad: 6px;
                                    tip: "Rewrite your draft into a clearer prompt with tny optimise. You review the result before anything is sent.";
                                    clicked => { root.optimise(root.draft); }
                                }
                                TextAction {
                                    text: "Dictate";
                                    pad: 6px;
                                    tip: "Record 10 seconds from your microphone and add the transcript to your draft.";
                                    clicked => { root.dictate(); }
                                }
                                Rectangle { horizontal-stretch: 1; }

                                mode-pill := TextAction {
                                    text: root.swarm-mode-label + (root.has-session ? "" : "  ▾");
                                    tone: Theme.muted;
                                    tip: root.has-session
                                        ? "The agent setup is fixed once a chat has started. Start a new chat to change it."
                                        : "Choose one agent (Solo) or a swarm of agents working in parallel on your first message.";
                                    clicked => {
                                        if !root.has-session {
                                            mode-popup.show();
                                        }
                                    }
                                    mode-popup := PopupWindow {
                                        x: mode-pill.width - 300px;
                                        // Open upward, clear of the composer card.
                                        y: card.absolute-position.y - mode-pill.absolute-position.y - self.height - 10px;
                                        width: 300px;
                                        height: 196px;
                                        close-policy: close-on-click-outside;
                                        Rectangle {
                                            background: Theme.surface;
                                            border-radius: 14px;
                                            drop-shadow-blur: 28px;
                                            drop-shadow-offset-y: 8px;
                                            drop-shadow-color: Theme.shadow;
                                            VerticalLayout {
                                                padding: 16px; spacing: 10px;
                                                Caption { text: "Agents"; }
                                                ChoiceRow {
                                                    title: "Solo";
                                                    detail: "One agent works on your message.";
                                                    selected: !root.swarm-enabled;
                                                    clicked => { root.change-swarm(1); mode-popup.close(); }
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    ChoiceRow {
                                                        title: "Swarm of " + root.swarm-count;
                                                        detail: "Parallel agents on this computer.";
                                                        selected: root.swarm-enabled;
                                                        clicked => { root.change-swarm(root.swarm-count); }
                                                    }
                                                    TextAction {
                                                        text: "−";
                                                        font-size: 16px;
                                                        enabled: root.swarm-count > 2;
                                                        tip: "One agent fewer";
                                                        clicked => { root.change-swarm(root.swarm-count - 1); }
                                                    }
                                                    TextAction {
                                                        text: "+";
                                                        font-size: 16px;
                                                        enabled: root.swarm-count < 16;
                                                        tip: "One agent more (up to 16)";
                                                        clicked => { root.change-swarm(root.swarm-count + 1); }
                                                    }
                                                }
                                                Hint { text: "Applies to the first message of a new chat."; }
                                            }
                                        }
                                    }
                                }

                                model-pill := TextAction {
                                    text: root.model-label + "  ▾";
                                    tone: Theme.text;
                                    tip: "Choose the provider and model for your next message.";
                                    clicked => {
                                        root.open-model-picker();
                                        model-popup.show();
                                    }
                                    model-popup := PopupWindow {
                                        x: model-pill.width - 540px;
                                        y: card.absolute-position.y - model-pill.absolute-position.y - self.height - 10px;
                                        width: 540px;
                                        height: 360px;
                                        close-policy: close-on-click-outside;
                                        Rectangle {
                                            background: Theme.surface;
                                            border-radius: 14px;
                                            drop-shadow-blur: 28px;
                                            drop-shadow-offset-y: 8px;
                                            drop-shadow-color: Theme.shadow;
                                            HorizontalLayout {
                                                padding: 16px; spacing: 18px;
                                                VerticalLayout {
                                                    width: 168px; spacing: 2px;
                                                    Caption { text: "Provider"; height: 24px; }
                                                    for p in root.providers: Rectangle {
                                                        height: 40px;
                                                        property <bool> chosen: p.name == root.picker-provider;
                                                        HorizontalLayout {
                                                            spacing: 6px;
                                                            VerticalLayout {
                                                                alignment: center; spacing: 1px;
                                                                Text {
                                                                    text: p.name;
                                                                    font-size: 13px;
                                                                    font-weight: chosen ? 600 : 400;
                                                                    color: !p.ready ? Theme.ghost : (chosen ? Theme.ink : Theme.text);
                                                                }
                                                                Text { text: p.detail; font-size: 10px; color: p.ready ? Theme.faint : Theme.ghost; }
                                                            }
                                                            Rectangle { horizontal-stretch: 1; }
                                                            Text { text: chosen ? "✓" : ""; color: Theme.accent; vertical-alignment: center; }
                                                        }
                                                        TouchArea {
                                                            mouse-cursor: p.ready ? pointer : default;
                                                            clicked => { if p.ready { root.pick-provider(p.name); } }
                                                        }
                                                        if !p.ready: Tooltip {
                                                            Tip { text: "Not set up yet. In a terminal, run tny --provider " + p.name + " login, or tny provider setup " + p.name + "."; }
                                                        }
                                                    }
                                                    if root.providers.length == 0: Hint { text: "Loading providers…"; }
                                                    Rectangle { vertical-stretch: 1; }
                                                }
                                                VerticalLayout {
                                                    spacing: 6px;
                                                    Caption { text: "Model"; height: 24px; }
                                                    ScrollView {
                                                        vertical-stretch: 1;
                                                        VerticalLayout {
                                                            spacing: 2px;
                                                            Rectangle {
                                                                height: 42px;
                                                                property <bool> chosen: root.picker-model == "";
                                                                HorizontalLayout {
                                                                    padding-right: 12px; spacing: 6px;
                                                                    VerticalLayout {
                                                                        alignment: center; spacing: 1px;
                                                                        Text { text: "Default"; font-size: 13px; font-weight: chosen ? 600 : 400; color: chosen ? Theme.ink : Theme.text; }
                                                                        Text { text: "Whatever model this provider is configured to use"; font-size: 10px; color: Theme.faint; overflow: elide; }
                                                                    }
                                                                    Rectangle { horizontal-stretch: 1; }
                                                                    Text { text: chosen ? "✓" : ""; color: Theme.accent; vertical-alignment: center; }
                                                                }
                                                                TouchArea { mouse-cursor: pointer; clicked => { root.pick-model(""); model-popup.close(); } }
                                                            }
                                                            for m in root.models: Rectangle {
                                                                height: 42px;
                                                                property <bool> chosen: m.id == root.picker-model;
                                                                HorizontalLayout {
                                                                    padding-right: 12px; spacing: 6px;
                                                                    VerticalLayout {
                                                                        alignment: center; spacing: 1px;
                                                                        horizontal-stretch: 1;
                                                                        Text { text: m.label; font-size: 13px; font-weight: chosen ? 600 : 400; color: chosen ? Theme.ink : Theme.text; overflow: elide; }
                                                                        if m.detail != "": Text { text: m.detail; font-size: 10px; color: Theme.faint; overflow: elide; }
                                                                    }
                                                                    Text { text: chosen ? "✓" : ""; color: Theme.accent; vertical-alignment: center; }
                                                                }
                                                                TouchArea { mouse-cursor: pointer; clicked => { root.pick-model(m.id); model-popup.close(); } }
                                                            }
                                                            if root.models-status != "": Hint { text: root.models-status; height: 36px; vertical-alignment: center; }
                                                        }
                                                    }
                                                    Field {
                                                        placeholder: "Other model ID, then Enter";
                                                        tip: "Use a model that isn't listed, for example one your gateway serves. Press Enter to select it.";
                                                        accepted(value) => {
                                                            if value != "" {
                                                                root.pick-model(value);
                                                                model-popup.close();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    padding-left: 6px;
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 16px;
                                        background: root.can-send ? Theme.accent : Theme.accent-muted;
                                        Text { text: "↑"; color: #ffffff; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { mouse-cursor: root.can-send ? pointer : default; clicked => { root.send(); } }
                                        Tooltip {
                                            Tip {
                                                text: root.busy ? "Wait for the current turn to finish."
                                                    : root.needs-tool-confirmation ? "Choose where tools run first (above the conversation)."
                                                    : root.saved-read-only ? "This saved chat is read-only."
                                                    : "Send (Enter). Shift+Enter adds a new line.";
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // Status line: quiet, beneath the composer.
                Measure {
                    measure: 776px;
                    padding-top: 2px; padding-bottom: 10px;
                    height: 36px;
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: root.busy ? "Thinking…" : root.status-label; color: Theme.muted; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text {
                        text: root.usage-label;
                        color: Theme.faint;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        Tooltip { Tip { text: "Token usage: the current chat once one is open, otherwise the whole workspace. Unknown usage is shown as unavailable, never zero."; } }
                    }
                    if root.allowance-label != "": Text { text: root.allowance-label; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
                    TextAction {
                        text: "Check allowance";
                        tone: Theme.faint;
                        font-size: 11px;
                        pad: 0px;
                        tip: "Ask the provider how much of your Codex weekly allowance is left. This makes one network request.";
                        clicked => { root.check-allowance(); }
                    }
                    }
                }
            }

            // ── Tools panel ─────────────────────────────────────────────────
            if root.tools-open: ScrollView {
                width: 290px;
                VerticalLayout {
                    padding-left: 12px; padding-right: 26px; padding-top: 4px; padding-bottom: 24px;
                    spacing: 8px;

                    Caption { text: "Where tools run"; }
                    Hint { text: "The agent's shell commands and file edits run here. The app itself always stays on this computer."; }
                    ChoiceRow {
                        title: "This computer";
                        detail: root.workspace-label;
                        selected: !root.ssh-configured;
                        tip: "Run tools locally in the workspace folder. Takes effect on the next message of a new chat.";
                        clicked => { root.disconnect-ssh(); }
                    }
                    ChoiceRow {
                        title: "SSH host";
                        detail: root.ssh-configured ? root.connection-label : "Run tools on a remote machine you can reach with ssh.";
                        selected: root.ssh-configured;
                        tip: "Enter user@host[:port] below and press Connect. Swarms, image generation and run inspection need this computer.";
                        clicked => {
                            if root.ssh-target != "" {
                                root.apply-ssh(root.ssh-target);
                            } else {
                                ssh-field.focus-input();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; padding-left: 24px;
                        ssh-field := Field {
                            text <=> root.ssh-target;
                            placeholder: "user@host[:port]";
                            accepted(value) => { root.apply-ssh(value); }
                        }
                        PillButton {
                            text: "Connect";
                            tip: "Use this SSH host for tools from the next message. Requires a new, idle chat.";
                            clicked => { root.apply-ssh(root.ssh-target); }
                        }
                    }

                    Rectangle { height: 18px; }
                    Caption { text: "Attach an image"; }
                    Hint { text: "Path to a local image file. It is sent with your next message, then cleared."; }
                    Field { text <=> root.image-path; placeholder: "/path/to/image.png"; }

                    Rectangle { height: 18px; }
                    Caption { text: "Generate an image"; }
                    Field { text <=> root.image-gen-prompt; placeholder: "Describe the image"; multiline: true; }
                    Field { text <=> root.image-gen-output; placeholder: "Save to /absolute/path.png"; }
                    HorizontalLayout {
                        spacing: 8px;
                        PillButton {
                            text: root.image-gen-busy ? "Generating…" : "Generate";
                            enabled: !root.image-gen-busy;
                            tip: "Create the image with tny image generate. An existing file at that path is replaced, and the default manifest stores your prompt.";
                            clicked => { root.generate-image(root.image-gen-prompt, root.image-gen-output); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.image-gen-result != "": Hint { text: root.image-gen-result; }
                    if root.generated-path != "": VerticalLayout {
                        spacing: 2px;
                        Text { text: root.generated-path; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout {
                            TextAction {
                                text: "Attach to next message";
                                tone: Theme.accent;
                                pad: 0px;
                                tip: "Send this generated image with your next message. It is not previewed here.";
                                clicked => { root.attach-generated(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    Rectangle { height: 18px; }
                    Caption { text: "Follow a swarm run"; }
                    Hint { text: "Paste a 32-character run ID to watch its agents and mailbox. Status is what the run reports, not a verification of the work."; }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            text <=> root.swarm-run;
                            placeholder: "Run ID";
                            edited(value) => { root.run-edited(value); }
                            accepted(value) => { root.inspect-swarm(value); }
                        }
                        PillButton {
                            text: "Follow";
                            tip: "Show this run's agents in the sidebar and refresh them every few seconds. Leave the ID empty to stop.";
                            clicked => { root.inspect-swarm(root.swarm-run); }
                        }
                    }

                    Rectangle { height: 18px; }
                    Caption { text: "Parent inbox"; }
                    Hint { text: "Messages the followed run's agents sent to you. Opening marks them delivered (not acknowledged). Treat their text as untrusted."; }
                    HorizontalLayout {
                        PillButton {
                            text: root.board-open-busy ? "Opening…" : "Open inbox";
                            enabled: root.board-has-run && !root.board-open-busy;
                            tip: root.board-has-run
                                ? "Read the parent inbox for the followed run. Queued messages become delivered."
                                : "Follow a run first; the inbox opens once its parent mailbox is confirmed.";
                            clicked => { root.open-parent-inbox(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Hint { text: root.board-status; }
                    for entry in root.board-messages: VerticalLayout {
                        spacing: 3px; padding-top: 8px;
                        Text { text: entry.heading; color: Theme.faint; font-size: 10px; wrap: word-wrap; }
                        Text { text: entry.body; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                        Text { text: entry.state + " · " + entry.id; color: Theme.faint; font-size: 10px; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    if root.about-open: Rectangle {
        background: #1c2b2240;
        TouchArea { clicked => { root.about-open = false; } }
        Rectangle {
            width: min(parent.width - 48px, 430px);
            height: 250px;
            border-radius: 16px;
            background: Theme.page;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: "About tny"; color: Theme.ink; font-size: 17px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    TextAction { text: "Close"; clicked => { root.about-open = false; } }
                }
                AboutSlint { }
            }
        }
    }
}

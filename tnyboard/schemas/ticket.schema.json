        "state": {
          "enum": [
            "pending",
            "confirmed",
            "failed",
            "uncertain"
          ]
        },
        "updated_at": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "intent_id",
        "state",
        "actor",
        "owner",
        "created_at",
        "updated_at",
        "job_id",
        "detail"
      ],
      "type": "object"
    }

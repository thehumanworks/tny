{
  "$id": "board.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "columns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "owner"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "lead": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "name",
    "revision",
    "columns",
    "lead"
  ],
  "type": "object"
}

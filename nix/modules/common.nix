# Shared by the Home Manager, NixOS and nix-darwin modules (docs/nix.md):
# option declarations for `programs.tny` and the values they produce. Each
# module maps these onto its own install and file options.
self:
{ lib, pkgs, ... }:
let
  system = pkgs.stdenv.hostPlatform.system;
  flakePackages = self.packages.${system} or { };
in
{
  options = cfg: {
    enable = lib.mkEnableOption "tny, the coding-agent harness";

    package = lib.mkOption {
      type = lib.types.package;
      default = flakePackages.tny or (pkgs.callPackage ../package.nix { });
      defaultText = lib.literalExpression "tny.packages.\${system}.tny";
      description = "The tny package to install.";
    };

    python = {
      enable = lib.mkEnableOption ''
        a Python 3 with the `tny` package (the SDK and the tool-extension API
        `tny.tool`, `tny.group`, `tny.proxy`) on PATH. This installs
        `python3`; if you already install a `python3`, add `ps.tny` to its
        `withPackages` instead (the overlay provides it) to avoid a collision
      '';

      package = lib.mkOption {
        type = lib.types.package;
        default = pkgs.python3;
        defaultText = lib.literalExpression "pkgs.python3";
        description = "The Python interpreter the `tny` package is added to.";
      };

      extraPackages = lib.mkOption {
        type = lib.types.functionTo (lib.types.listOf lib.types.package);
        default = _: [ ];
        defaultText = lib.literalExpression "ps: [ ]";
        example = lib.literalExpression "ps: [ ps.pydantic ps.httpx ]";
        description = "More packages for the same Python environment.";
      };

      libtny = lib.mkEnableOption ''
        libtny for the SDK's `Runtime` and `Toolkit` (sets `TNY_LIBRARY_PATH`).
        The tool-extension API does not need it. Builds libtny from source
      '';
    };

    neovim = {
      enable = lib.mkEnableOption ''
        a Neovim (0.11+) LSP setup for tool extensions: a language server
        that resolves `import tny` to the typed package, with no other
        configuration. It is a runtime `plugin/` file, so it works beside
        your own init.lua and nvim-lspconfig
      '';

      server = lib.mkOption {
        type = lib.types.enum [
          "basedpyright"
          "pyright"
        ];
        default = "basedpyright";
        description = "The language server to configure and install.";
      };

      installServer = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Install the language server's package.";
      };
    };

    pyrightConfig = lib.mkOption {
      type = lib.types.bool;
      default = cfg.python.enable || cfg.neovim.enable;
      defaultText = lib.literalExpression "python.enable || neovim.enable";
      description = ''
        Write a `pyrightconfig.json` into the global extension directory
        (`~/.tny/extensions/tools`) so any pyright-based editor (VS Code,
        Zed, Helix, Neovim) types extension code there. Home Manager only.
      '';
    };

    skill = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Install the `tny-tool-extensions` agent skill into `~/.tny/skills`,
        so tny agents know how to write tool extensions. Home Manager only.
      '';
    };
  };

  # What the options produce, for a given evaluated `cfg`.
  values =
    cfg:
    let
      pythonPackages = cfg.python.package.pkgs;
      tnyPython = pythonPackages.callPackage ../python-package.nix { };
      sitePackages = "${tnyPython}/${cfg.python.package.sitePackages}";
      pythonEnv = cfg.python.package.withPackages (ps: [ tnyPython ] ++ cfg.python.extraPackages ps);
      libtny = flakePackages.libtny or null;
      libtnyFile = if pkgs.stdenv.hostPlatform.isDarwin then "lib/libtny.1.dylib" else "lib/libtny.so.1";
      serverPackage = if cfg.neovim.server == "pyright" then pkgs.pyright else pkgs.basedpyright;
      settingsKey = if cfg.neovim.server == "pyright" then "python" else "basedpyright";
    in
    {
      inherit tnyPython sitePackages;

      packages = [
        cfg.package
      ]
      ++ lib.optional cfg.python.enable pythonEnv
      ++ lib.optional (cfg.neovim.enable && cfg.neovim.installServer) serverPackage;

      variables = lib.optionalAttrs (cfg.python.enable && cfg.python.libtny && libtny != null) {
        TNY_LIBRARY_PATH = "${libtny}/${libtnyFile}";
      };

      pyrightConfig = builtins.toJSON {
        extraPaths = [ sitePackages ];
        pythonVersion = "3.14"; # the tool host's interpreter
        typeCheckingMode = "standard";
      };

      neovimLua = ''
        -- Generated by the tny Nix module (programs.tny.neovim): LSP for tny
        -- tool extensions. `import tny` resolves to ${sitePackages}.
        if vim.fn.has("nvim-0.11") == 0 or vim.fn.executable("${cfg.neovim.server}-langserver") == 0 then
          return
        end
        vim.lsp.config("${cfg.neovim.server}", {
          cmd = { "${cfg.neovim.server}-langserver", "--stdio" },
          filetypes = { "python" },
          root_markers = { "pyrightconfig.json", "pyproject.toml", "setup.py", ".git" },
          settings = {
            ${settingsKey} = {
              analysis = { extraPaths = { "${sitePackages}" } },
            },
          },
        })
        vim.lsp.enable("${cfg.neovim.server}")
      '';
    };
}
